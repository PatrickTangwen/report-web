    "/paper/question": {
      "post": {
        "description": "Paper Question Mode: bounded in-task agent over Study Evidence.\n\nTask selection stays explicit (ADR-0010); within this task the agent\norchestrates the Study Evidence tools (ADR-0013, ADR-0014). Unlike\n/chat, no intent classification or keyword routing runs here. The\nresponse contract is unchanged; tool_trace is additive metadata the\nwidget ignores.",
        "operationId": "paper_question_paper_question_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaperQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperQuestionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Paper Question"
      }
    },
    "/paper/question/stream": {
      "post": {
        "description": "SSE variant of /paper/question: tool-activity events plus streamed\nanswer tokens (event types: tool_call, tool_result, token, done, error).\n\nThe widget degrades to the non-streaming endpoint only on connection\nfailure; a mid-stream error event is terminal, never silently refetched.",
        "operationId": "paper_question_stream_paper_question_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaperQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Paper Question Stream"
      }
    },
