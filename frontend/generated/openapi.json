{
  "components": {
    "schemas": {
      "FeatureCandidate": {
        "properties": {
          "field": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "operation": {
            "default": "set",
            "enum": [
              "set",
              "correct",
              "remove"
            ],
            "title": "Operation",
            "type": "string"
          },
          "raw_unit": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Unit"
          },
          "raw_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Value"
          },
          "source_text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Text",
            "type": "string"
          }
        },
        "required": [
          "field",
          "raw_value",
          "source_text"
        ],
        "title": "FeatureCandidate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Message": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "type": "object"
      },
      "PaperQuestionRequest": {
        "properties": {
          "history": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "title": "History",
            "type": "array"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "PaperQuestionRequest",
        "type": "object"
      },
      "PaperQuestionResponse": {
        "properties": {
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "tool_trace": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ToolTraceEntry"
            },
            "title": "Tool Trace",
            "type": "array"
          }
        },
        "required": [
          "reply"
        ],
        "title": "PaperQuestionResponse",
        "type": "object"
      },
      "ProfileConfirmRequest": {
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/ProfileDraftInput"
          }
        },
        "required": [
          "draft"
        ],
        "title": "ProfileConfirmRequest",
        "type": "object"
      },
      "ProfileCoverageRequest": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/FeatureCandidate"
            },
            "maxItems": 100,
            "title": "Candidates",
            "type": "array"
          },
          "target": {
            "enum": [
              "CKD",
              "Cardiac_Fibrosis",
              "MASH",
              "Pulmonary_fibrosis",
              "SSc_Connective_Tissue",
              "Crohns_Disease",
              "Fibrosis_of_Skin"
            ],
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "candidates",
          "target"
        ],
        "title": "ProfileCoverageRequest",
        "type": "object"
      },
      "ProfileDraftInput": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/FeatureCandidate"
            },
            "maxItems": 100,
            "title": "Candidates",
            "type": "array"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "candidates"
        ],
        "title": "ProfileDraftInput",
        "type": "object"
      },
      "ProfileExtractRequest": {
        "properties": {
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ProfileExtractRequest",
        "type": "object"
      },
      "ProfileExtractResponse": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/FeatureCandidate"
            },
            "title": "Candidates",
            "type": "array"
          }
        },
        "required": [
          "candidates"
        ],
        "title": "ProfileExtractResponse",
        "type": "object"
      },
      "ProfileMatchRequest": {
        "properties": {
          "confirmed_profile": {
            "$ref": "#/components/schemas/ProfileDraftInput"
          },
          "target": {
            "enum": [
              "CKD",
              "Cardiac_Fibrosis",
              "MASH",
              "Pulmonary_fibrosis",
              "SSc_Connective_Tissue",
              "Crohns_Disease",
              "Fibrosis_of_Skin"
            ],
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "confirmed_profile",
          "target"
        ],
        "title": "ProfileMatchRequest",
        "type": "object"
      },
      "ProfileValidateRequest": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/FeatureCandidate"
            },
            "maxItems": 100,
            "title": "Candidates",
            "type": "array"
          }
        },
        "required": [
          "candidates"
        ],
        "title": "ProfileValidateRequest",
        "type": "object"
      },
      "ResearchDataMetadataResponse": {
        "properties": {
          "dataset_version": {
            "title": "Dataset Version",
            "type": "string"
          },
          "datasets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ResearchDatasetMetadata"
            },
            "title": "Datasets",
            "type": "object"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "released_on": {
            "title": "Released On",
            "type": "string"
          },
          "schema_version": {
            "const": "research-data-release-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "mock",
              "published"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "dataset_version",
          "released_on",
          "status",
          "description",
          "datasets"
        ],
        "title": "ResearchDataMetadataResponse",
        "type": "object"
      },
      "ResearchDatasetMetadata": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          }
        },
        "required": [
          "row_count",
          "columns"
        ],
        "title": "ResearchDatasetMetadata",
        "type": "object"
      },
      "SyntheticExampleProfileResponse": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/FeatureCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "review_status": {
            "title": "Review Status",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "target",
          "version",
          "review_status",
          "candidates"
        ],
        "title": "SyntheticExampleProfileResponse",
        "type": "object"
      },
      "ToolTraceEntry": {
        "properties": {
          "arguments": {
            "title": "Arguments",
            "type": "string"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "arguments",
          "ok"
        ],
        "title": "ToolTraceEntry",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
